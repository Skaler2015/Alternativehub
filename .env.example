# ── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://alternativehub.in"

# ── Database (PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alternativehub?schema=public"

# ── Auth (NextAuth v5) ─────────────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="https://alternativehub.in"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Redis (cache + rate limiting) ──────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Meilisearch (instant search) ───────────────────────────────────────
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="masterKey"

# ── Cloudinary (media CDN) ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── AI (provider-agnostic) ─────────────────────────────────────────────
# Choose the provider: "gemini" (free tier), "anthropic" (paid), or "auto".
# "auto" prefers Gemini when GEMINI_API_KEY is set, else Anthropic.
AI_PROVIDER="auto"

# Google Gemini — FREE tier. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Anthropic Claude — paid (pay-as-you-go). Optional; add later if you switch.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"

# ── Cron (daily maintenance automation) ────────────────────────────────
# Any long random string. Vercel Cron sends this as a Bearer token so only
# Vercel can trigger /api/cron/maintenance. Generate: openssl rand -base64 24
CRON_SECRET=""

# ── Email (optional, provider: Resend) ─────────────────────────────────
# Enables welcome emails + contact-form notifications. Fully optional —
# without a key the app behaves exactly as before (nothing is sent).
# Free tier: 3,000 emails/month. Get a key at https://resend.com
RESEND_API_KEY=""
# FROM address — must be on a domain verified in Resend.
EMAIL_FROM="AlternativeHub <hello@alternativehub.in>"

# ── SEO ────────────────────────────────────────────────────────────────
# Google Search Console verification token (the content="" value of the
# google-site-verification meta tag). Add it to verify site ownership.
GOOGLE_SITE_VERIFICATION=""
