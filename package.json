{
  "name": "alternativehub",
  "version": "1.0.0",
  "private": true,
  "description": "AlternativeHub — Discover Better Alternatives. Enterprise-grade platform for discovering alternatives to apps, websites, AI tools and software.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "db:setup": "prisma generate && tsx scripts/db-wait.ts && tsx scripts/migrate-retry.ts && tsx scripts/seed-if-empty.ts && tsx scripts/backfill-details.ts && tsx scripts/expand-catalog.ts && tsx scripts/expand-catalog-2.ts && tsx scripts/expand-catalog-3.ts && tsx scripts/expand-catalog-4.ts && tsx scripts/expand-catalog-5.ts && tsx scripts/expand-catalog-6.ts",
    "vercel-build": "prisma generate && tsx scripts/db-wait.ts && tsx scripts/migrate-retry.ts && tsx scripts/seed-if-empty.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "search:sync": "tsx scripts/sync-search.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^6.5.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.6.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.6.0",
    "geist": "^1.3.1",
    "ioredis": "^5.6.0",
    "lucide-react": "^0.487.0",
    "meilisearch": "^0.50.0",
    "next": "^15.3.0",
    "next-auth": "^5.0.0-beta.29",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "postcss": "^8.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
